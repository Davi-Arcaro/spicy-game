{
  "name": "spicy-game",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "mobile": "bun --filter './apps/mobile' dev",
    "mobile:ios": "bun --filter './apps/mobile' ios",
    "mobile:android": "bun --filter './apps/mobile' android",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:gen-types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts"
  }
}
